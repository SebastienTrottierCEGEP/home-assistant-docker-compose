                  }
                },
                {
                  "type": "button",
                  "show_name": true,
                  "show_icon": true,
                  "icon": "mdi:home-import-outline",
                  "name": "Retour",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.exercice_18_retour"
                  }
                },
                {
                  "type": "button",
                  "show_name": true,
                  "show_icon": true,
                  "icon": "mdi:bed",
                  "name": "Coucher",
                  "tap_action": {
