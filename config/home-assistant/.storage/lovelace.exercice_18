                    "columns": 12,
                    "rows": 1
                  }
                }
              ],
              "column_span": 1
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Scripts",
                  "heading_style": "title",
                  "icon": "mdi:script-text"
                },
                {
                  "type": "button",
                  "show_name": true,
                  "show_icon": true,
                  "icon": "mdi:alarm",
                  "name": "Réveil",
                  "tap_action": {
                    "action": "perform-action",
